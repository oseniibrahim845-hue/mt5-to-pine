// This Pine Script was generated from MQL5 by mt5-to-pine.
// Review the notes the converter returned before trading with it.
//@version=6
strategy("RSI Reversal with time filter", overlay = true, pyramiding = 1, calc_on_every_tick = false)

// ---- Inputs ----
RsiPeriod = input.int(14, "RSI period")
RsiPrice = input.source(close, "RSI price")
Oversold = input.float(30.0, "Oversold level")
Overbought = input.float(70.0, "Overbought level")
Lots = input.float(0.1, "Lots")
AtrMultSL = input.float(1.5, "SL = ATR x")
AtrMultTP = input.float(3.0, "TP = ATR x")
TradeDir_str = input.string("DIR_BOTH", "Trade direction", options = ["DIR_BOTH", "DIR_LONG", "DIR_SHORT"])
TradeDir = TradeDir_str == "DIR_BOTH" ? 0 : TradeDir_str == "DIR_LONG" ? 1 : 2
StartHour = input.int(8, "Start hour")
EndHour = input.int(20, "End hour")
MaxTradesPerDay = input.int(3, "Max trades per day")

// ---- Helpers ----
// Position seen by the EA logic on this bar (MT5 updates it right after each order).
var posState = array.new_float(1, 0.0)
f_pos() => array.get(posState, 0)

// ---- Indicators ----
atr = ta.atr(14)
rsi = ta.rsi(RsiPrice, RsiPeriod)

// ---- Variables ----
var int tradesToday = 0
var int lastDay = -1
var int lastBarTime = 0

// ---- Functions ----
InSession() =>
    if (dayofweek(time) - 1) == 0 or (dayofweek(time) - 1) == 6
        false
    else
        hour(time) >= StartHour and hour(time) < EndHour

HasPosition() =>
    bool result_ = false
    bool done_ = false
    if (f_pos() != 0 ? 1 : 0) - 1 >= 0
        for i = (f_pos() != 0 ? 1 : 0) - 1 to 0 by -1
            int ticket = (f_pos() != 0 ? 1 : 0)
            if ticket > 0
                result_ := true
                done_ := true
                break
    if not done_
        result_ := false
        done_ := true
    result_

// ---- Logic (runs once per bar, like OnTick on a new bar) ----
array.set(posState, 0, strategy.position_size)
// OnInit()
if barstate.isfirst
    if Oversold >= Overbought
        log.info("Oversold must be below Overbought")
        runtime.error("OnInit failed")
bool tick_done = false
int t = time
if t == lastBarTime
    tick_done := true
if not tick_done
    lastBarTime := t
    // CountDay()
    if true
        if dayofmonth(time) != lastDay
            lastDay := dayofmonth(time)
            tradesToday := 0
    if not InSession()
        tick_done := true
    if not tick_done
        if tradesToday >= MaxTradesPerDay
            tick_done := true
        if not tick_done
            if HasPosition()
                tick_done := true
            if not tick_done
                float price = close
                float a = atr
                bool case_done = false
                if TradeDir == 1 or TradeDir == 0
                    if rsi[1] < Oversold and rsi >= Oversold
                        strategy.entry("Buy", strategy.long, qty = Lots)
                        array.set(posState, 0, Lots)
                        strategy.exit("Buy SL/TP", from_entry = "Buy", stop = price - AtrMultSL * a, limit = price + AtrMultTP * a)
                        tradesToday += 1
                        tick_done := true
                    if not tick_done
                        if TradeDir == 1
                            case_done := true
                        if not case_done
                            if rsi[1] > Overbought and rsi <= Overbought
                                price := close
                                strategy.entry("Sell", strategy.short, qty = Lots)
                                array.set(posState, 0, -Lots)
                                strategy.exit("Sell SL/TP", from_entry = "Sell", stop = price + AtrMultSL * a, limit = price - AtrMultTP * a)
                                tradesToday += 1
                else if TradeDir == 2
                    if rsi[1] > Overbought and rsi <= Overbought
                        price := close
                        strategy.entry("Sell", strategy.short, qty = Lots)
                        array.set(posState, 0, -Lots)
                        strategy.exit("Sell SL/TP", from_entry = "Sell", stop = price + AtrMultSL * a, limit = price - AtrMultTP * a)
                        tradesToday += 1
